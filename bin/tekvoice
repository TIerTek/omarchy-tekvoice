#!/bin/sh
# TekVoice control CLI. SPDX-License-Identifier: GPL-3.0-or-later
#
# Voice changes are a single property write on the running capture node, so the
# TekVoice microphone is never torn down and never drops out of a live call.
set -eu

HERE=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
# Per-user runtime dir only. A shared /tmp fallback would let another account
# plant the pidfile this script later passes to `kill`.
[ -n "${TEKVOICE_STATE_DIR:-}" ] || [ -n "${XDG_RUNTIME_DIR:-}" ] \
    || { echo "tekvoice: XDG_RUNTIME_DIR is not set - run inside a normal login session" >&2; exit 1; }
STATE_DIR="${TEKVOICE_STATE_DIR:-$XDG_RUNTIME_DIR/tekvoice}"
CONF_DIR="$STATE_DIR/pw"
STATE="$STATE_DIR/state"
PIDFILE="$STATE_DIR/pid"
LOG="$STATE_DIR/log"
VOICES="$HERE/voices.json"

die() { echo "tekvoice: $*" >&2; exit 1; }

LADSPA_DIR="${TEKVOICE_LADSPA_DIR:-$HOME/.ladspa}"
MAKE="${MAKE:-make}"

# `omarchy plugin add` only runs `git clone`: a marketplace install has the
# sources and no engine. Build it in place, first time and after every update
# (make is a no-op when nothing changed). Everything stays in the plugin dir.
build_so() {
    missing=""
    command -v "$MAKE" >/dev/null 2>&1 || missing="$missing make"
    command -v "${CXX:-g++}" >/dev/null 2>&1 || missing="$missing g++"
    command -v pkg-config >/dev/null 2>&1 || missing="$missing pkg-config"
    [ -n "$missing" ] && die "cannot build the audio engine, missing:$missing - install them with: sudo pacman -S --needed base-devel rubberband"
    pkg-config --exists rubberband 2>/dev/null \
        || die "cannot build the audio engine, Rubber Band is missing - install it with: sudo pacman -S --needed rubberband"
    mkdir -p "$STATE_DIR"
    "$MAKE" -s -C "$HERE" build/libtekvoice.so >"$STATE_DIR/build.log" 2>&1 \
        || die "building the audio engine failed; see $STATE_DIR/build.log"
    echo "$HERE/build/libtekvoice.so"
}

# An explicit TEKVOICE_SO or install.sh's copy wins; otherwise the in-place build.
resolve_so() {
    for c in "${TEKVOICE_SO:-}" "$LADSPA_DIR/libtekvoice.so"; do
        [ -n "$c" ] && [ -f "$c" ] && { echo "$c"; return 0; }
    done
    build_so
}

state_get() { [ -f "$STATE" ] && sed -n "s/^$1=//p" "$STATE" | tail -1 || true; }
state_set() {
    mkdir -p "$STATE_DIR"
    touch "$STATE"
    grep -v "^$1=" "$STATE" > "$STATE.tmp" 2>/dev/null || true
    echo "$1=$2" >> "$STATE.tmp"
    mv "$STATE.tmp" "$STATE"
}

# The pidfile holds "<pid> <starttime>". A pid only counts if it is still the
# exact process `arm` spawned: same kernel start time (a reused pid has a new
# one), `pipewire -c filter-chain.conf`, and our private PIPEWIRE_CONFIG_DIR.
# The user's own PipeWire daemon fails all three, so disarm can never kill it.
#   proc_ctl start <pid>         print the pid's start time
#   proc_ctl check <pid> <start> exit 0 only if it is our filter process
#   proc_ctl kill  <pid> <start> pin it with a pidfd, re-check, then SIGTERM
# Kill opens the pidfd FIRST and verifies after, so the pid cannot be reused
# between the check and the signal.
proc_ctl() {
    python3 - "$CONF_DIR" "$@" <<'PY'
import os, signal, sys
conf, mode, pid = sys.argv[1], sys.argv[2], sys.argv[3]
if not pid.isdigit(): sys.exit(1)
def start(p):
    try: st = open("/proc/%s/stat" % p).read()
    except OSError: return None
    return st[st.rindex(")") + 2:].split()[19]
def ours(p, want):
    try:
        if start(p) != want: return False
        if open("/proc/%s/comm" % p).read().strip() != "pipewire": return False
        argv = open("/proc/%s/cmdline" % p, "rb").read().split(b"\0")[:-1]
        if [os.path.basename(argv[0])] + argv[1:] != [b"pipewire", b"-c", b"filter-chain.conf"]:
            return False
        env = open("/proc/%s/environ" % p, "rb").read().split(b"\0")
        return ("PIPEWIRE_CONFIG_DIR=" + conf).encode() in env
    except (OSError, IndexError):
        return False
if mode == "start":
    s = start(pid)
    if s is None: sys.exit(1)
    print(s); sys.exit(0)
want = sys.argv[4] if len(sys.argv) > 4 else ""
if not want.isdigit(): sys.exit(1)
if mode == "check":
    sys.exit(0 if ours(pid, want) else 1)
if mode == "kill":
    try: fd = os.pidfd_open(int(pid))
    except OSError: sys.exit(1)
    try:
        if not ours(pid, want): sys.exit(1)
        signal.pidfd_send_signal(fd, signal.SIGTERM)
    finally:
        os.close(fd)
    sys.exit(0)
sys.exit(1)
PY
}

running() {
    [ -f "$PIDFILE" ] || return 1
    read -r pid start < "$PIDFILE" || true
    proc_ctl check "${pid:-}" "${start:-}"
}

# Control ports live on the CAPTURE node, not the source node.
capture_id() {
    pw-dump 2>/dev/null | python3 -c '
import sys, json
try: d = json.load(sys.stdin)
except Exception: sys.exit(1)
for o in d:
    if o.get("type") != "PipeWire:Interface:Node": continue
    if o.get("info", {}).get("props", {}).get("node.name") == "tekvoice_in":
        print(o["id"]); break
'
}

source_id() {
    pw-dump 2>/dev/null | python3 -c '
import sys, json
try: d = json.load(sys.stdin)
except Exception: sys.exit(1)
for o in d:
    if o.get("type") != "PipeWire:Interface:Node": continue
    if o.get("info", {}).get("props", {}).get("node.name") == "tekvoice_src":
        print(o["id"]); break
'
}

consumers() {
    sid=$(source_id)
    [ -n "$sid" ] || { echo 0; return; }
    pw-dump 2>/dev/null | python3 -c '
import sys, json
sid = int(sys.argv[1])
try: d = json.load(sys.stdin)
except Exception: print(0); sys.exit(0)
n = 0
for o in d:
    if o.get("type") != "PipeWire:Interface:Link": continue
    if o.get("info", {}).get("output-node-id") == sid: n += 1
print(n)
' "$sid"
}

# Emit the eight control values for a voice, scaled by strength, as pw-cli params.
voice_params() {
    python3 - "$VOICES" "$1" "$2" <<'PY'
import json, sys
path, vid, strength = sys.argv[1], sys.argv[2], float(sys.argv[3]) / 100.0
doc = json.load(open(path))
v = next((x for x in doc["voices"] if x["id"] == vid), None)
if v is None:
    sys.exit(1)
# Strength pulls the character back toward the user's real voice. Band and Tilt
# are voicing/EQ, not character depth, so they scale too - all of it collapses
# to a dry signal at strength 0.
out = []
for k, name in (("pitch","Pitch"),("formant","Formant"),("band","Band"),
                ("tilt","Tilt"),("grit","Grit"),("ring","Ring"),("noise","Noise")):
    out.append('"tv:%s" %s' % (name, float(v[k]) * strength))
out.append('"tv:Mix" 1.0')
print(" ".join(out))
PY
}

apply_voice() {
    vid="$1"
    st="$(state_get strength)"; [ -n "$st" ] || st=100
    params=$(voice_params "$vid" "$st") || die "unknown voice: $vid"
    cid=$(capture_id)
    [ -n "$cid" ] || die "TekVoice is not running"
    # One write carries all eight values, so the voice changes atomically.
    pw-cli s "$cid" Props "{ params = [ $params ] }" >/dev/null 2>&1 \
        || die "failed to write controls to node $cid"
}

cmd_arm() {
    if running; then echo "already armed"; return 0; fi
    so=$(resolve_so)
    mkdir -p "$CONF_DIR/filter-chain.conf.d"
    cp /usr/share/pipewire/filter-chain.conf "$CONF_DIR/filter-chain.conf" \
        || die "PipeWire's filter-chain.conf is missing - is pipewire installed?"
    sed "s|@SO@|$so|" "$HERE/pipewire/tekvoice.conf.in" \
        > "$CONF_DIR/filter-chain.conf.d/tekvoice.conf"

    PIPEWIRE_CONFIG_DIR="$CONF_DIR" setsid pipewire -c filter-chain.conf \
        >"$LOG" 2>&1 &
    pid=$!
    # Start time survives exec, so it can be recorded before pipewire is up.
    start=$(proc_ctl start "$pid") || { rm -f "$PIDFILE"; die "the filter process exited immediately; see $LOG"; }
    echo "$pid $start" > "$PIDFILE"

    i=0
    while [ $i -lt 30 ]; do
        if pactl list short sources 2>/dev/null | grep -q tekvoice_src; then
            state_set armed yes
            [ -n "$(state_get strength)" ] || state_set strength 100
            echo "armed - select \"TekVoice\" as your microphone"
            return 0
        fi
        # Our own unreaped child, so kill -0 is safe here; full identity is
        # checked once it has exec'd into pipewire.
        kill -0 "$pid" 2>/dev/null || break
        sleep 0.1
        i=$((i + 1))
    done
    echo "tekvoice: failed to arm; log follows" >&2
    tail -5 "$LOG" >&2 2>/dev/null || true
    proc_ctl kill "$pid" "$start" || true
    rm -f "$PIDFILE"
    exit 1
}

cmd_disarm() {
    force=${1:-}
    running || { state_set armed no; echo "not armed"; return 0; }
    n=$(consumers)
    if [ "$n" -gt 0 ] && [ "$force" != "--force" ]; then
        die "$n application(s) are using TekVoice; use 'panic' to return your real voice, or 'disarm --force'"
    fi
    read -r pid start < "$PIDFILE" || true
    proc_ctl kill "${pid:-}" "${start:-}" || true
    rm -f "$PIDFILE"
    state_set armed no
    state_set mix 0
    echo "disarmed"
}

cmd_set() {
    [ $# -ge 1 ] || die "usage: tekvoice set <voice>"
    running || die "not armed - run 'tekvoice arm' first"
    apply_voice "$1"
    state_set voice "$1"
    state_set mix 1
    echo "voice: $1"
}

cmd_strength() {
    [ $# -ge 1 ] || die "usage: tekvoice strength <0-100>"
    case "$1" in ''|*[!0-9]*) die "strength must be 0-100" ;; esac
    [ "$1" -le 100 ] || die "strength must be 0-100"
    state_set strength "$1"
    v="$(state_get voice)"
    if running && [ -n "$v" ] && [ "$(state_get mix)" = "1" ]; then apply_voice "$v"; fi
    echo "strength: $1"
}

# Cycling lives in the CLI, not the bar widget, so the hotkeys keep working
# when the shell is down or the widget is not in the bar.
cmd_cycle() {
    running || die "not armed - run 'tekvoice arm' first"
    dir="$1"
    cur="$(state_get voice)"
    next=$(python3 - "$VOICES" "$cur" "$dir" <<'PY2'
import json, sys
path, cur, d = sys.argv[1], sys.argv[2], int(sys.argv[3])
ids = [v["id"] for v in json.load(open(path))["voices"]]
if not ids: sys.exit(1)
i = ids.index(cur) if cur in ids else -1
print(ids[0] if i < 0 else ids[(i + d) % len(ids)])
PY2
) || die "could not read $VOICES"
    apply_voice "$next"
    state_set voice "$next"
    state_set mix 1
    echo "voice: $next"
}

cmd_panic() {
    running || { echo "not armed"; return 0; }
    cid=$(capture_id)
    [ -n "$cid" ] || die "TekVoice is not running"
    pw-cli s "$cid" Props '{ params = [ "tv:Mix" 0.0 ] }' >/dev/null 2>&1 \
        || die "failed to write controls to node $cid"
    state_set mix 0
    echo "panic - your real voice is back"
}

cmd_status() {
    if running; then
        echo "armed=yes"
        echo "consumers=$(consumers)"
    else
        echo "armed=no"
        echo "consumers=0"
    fi
    v="$(state_get voice)"; [ -n "$v" ] && echo "voice=$v" || true
    s="$(state_get strength)"; [ -n "$s" ] || s=100; echo "strength=$s"
    m="$(state_get mix)"; [ -n "$m" ] || m=0; echo "mix=$m"
}

case "${1:-}" in
    arm)      shift; cmd_arm ;;
    disarm)   shift; cmd_disarm "${1:-}" ;;
    set)      shift; cmd_set "$@" ;;
    strength) shift; cmd_strength "$@" ;;
    next)     shift; cmd_cycle 1 ;;
    prev)     shift; cmd_cycle -1 ;;
    panic)    shift; cmd_panic ;;
    status)   shift; cmd_status ;;
    build)    shift; so=$(build_so); echo "built $so" ;;
    *) echo "usage: tekvoice arm|disarm [--force]|set <voice>|next|prev|strength <0-100>|panic|status|build" >&2; exit 1 ;;
esac
